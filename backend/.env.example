# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pricebuddy
PORT=5001

# ── Search (v0.0.50) ─────────────────────────────
# Shops to search, comma separated: amazon, googleShopping, ebay, bol
SEARCH_SOURCES=amazon,googleShopping,ebay,bol
SEARCH_CURRENCY=EUR
SEARCH_LOCALE=nl-NL
SEARCH_CACHE_MINUTES=60

# SerpApi (amazon + googleShopping). Free plan: 250 searches/month.
SERPAPI_KEY=
SERPAPI_MONTHLY_LIMIT=250
AMAZON_DOMAIN=amazon.nl
SHOPPING_COUNTRY=nl

# eBay Browse API (developer.ebay.com)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_MARKETPLACE=EBAY_NL

# bol.com Marketing Catalog API (partner.bol.com)
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# Price alert e-mails
EMAIL_USER=
EMAIL_PASS=

# ── Product-page scraping (v0.0.53) ──────────────
# Headless Chrome fallback for shops with bot protection (true/false)
SCRAPE_BROWSER=true
SCRAPE_ACCEPT_LANGUAGE=nl-NL,nl;q=0.9,en;q=0.8
# Optional: use a system Chrome instead of the one puppeteer downloads
PUPPETEER_EXECUTABLE_PATH=
# Optional paid proxy for hard sites (scraperapi.com)
SCRAPER_API_KEY=

# ── Database (v0.0.56) ───────────────────────────
# Default: SQLite file. Set DB_CLIENT=mysql (plus the DB_* values above) to use MySQL instead.
DB_CLIENT=sqlite
SQLITE_PATH=./data/pricebuddies.db
